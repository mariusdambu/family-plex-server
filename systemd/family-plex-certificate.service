[Unit]
Description=Renew the explicitly configured dashboard HTTPS certificate
After=network-online.target tailscaled.service
Wants=network-online.target
ConditionPathExists=/etc/family-plex/tls/domain

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/family-plex/dashboard_certificate.py
TimeoutStartSec=240
